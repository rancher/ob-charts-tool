#!/bin/bash
set -e

cd $(dirname $0)/..

echo "Running golang tests..."

# Run all unit tests (integration tests are excluded via build tags)
# Integration tests require network access and must be run separately via:
#   ./scripts/test-integration
#   make test-integration

echo "Testing root module..."
go test -cover ./...

echo ""
echo "Testing helmtools module..."
go test -cover ./helmtools/...
